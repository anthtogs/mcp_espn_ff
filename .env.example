# Required together for private ESPN leagues; omit both for public leagues.
ESPN_S2=
ESPN_SWID=

# Required whenever either ESPN credential is configured. Clients send this as
# an Authorization: Bearer <value> header.
MCP_API_KEY=

# Enables ChatGPT OAuth. Generate both values independently and keep them
# server-side. OAUTH_LOGIN_PASSWORD is entered only on the authorization page.
OAUTH_SIGNING_SECRET=
OAUTH_LOGIN_PASSWORD=

# Public canonical URLs. Production values for this deployment are shown below.
OAUTH_ISSUER_URL=https://mcp-espn-ff.vercel.app
MCP_RESOURCE_URL=https://mcp-espn-ff.vercel.app/api/mcp

# Optional; defaults to INFO.
LOG_LEVEL=INFO
